{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "lib": ["ES2022", "DOM"],
    "strict": true, "esModuleInterop": true, "resolveJsonModule": true,
    "skipLibCheck": true, "noEmit": true, "moduleResolution": "node",
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*", "scripts/**/*"]
}
