{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "ignoreCommand": "exit 1",
  "crons": [
    {
      "path": "/api/cron/commons-lock",
      "schedule": "0 6 * * *"
    }
  ]
}
