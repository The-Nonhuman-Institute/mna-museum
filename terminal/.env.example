# ─────────────────────────────────────────────────────────────────
# MNA Steward Terminal — environment configuration
#
# Two deployment modes:
#   LOCAL DEV  → copy to terminal/.env and fill in values
#   PRODUCTION → set these as Vercel project env vars in the dashboard
#
# terminal/.env is gitignored. Do NOT commit real secrets to this
# example file.
# ─────────────────────────────────────────────────────────────────

# ── Auth ─────────────────────────────────────────────────────────
# STEWARD_PASSWORD_HASH — bcrypt hash of the steward password.
#
#   LOCAL DEV: leave this BLANK. Run `npm run hash-password` instead;
#   the script writes the hash to data/steward.hash (mode 0600) and
#   the terminal reads it from there. Reason: bcrypt hashes contain
#   `$` characters that dotenv-expand silently corrupts when .env is
#   loaded locally, so the file is the only safe local path.
#
#   VERCEL PRODUCTION: set this env var in the Vercel dashboard. The
#   dashboard stores env vars as raw strings and bypasses dotenv-expand
#   entirely, so the bcrypt `$` characters survive intact. Generate
#   the hash on your machine with `npm run hash-password` (it will
#   also print the hash to stdout), copy it, and paste into the
#   Vercel env var. Mode 0600 file is ignored in production.
STEWARD_PASSWORD_HASH=

# HMAC secret for signing session cookies. Generate with:
#   openssl rand -hex 32
STEWARD_SESSION_SECRET=

# ── Model provider ───────────────────────────────────────────────
# "anthropic" (default, Claude API) or "ollama" (local, Mac Studio only)
MODEL_PROVIDER=anthropic

# Required if MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-sonnet-4-20250514.
# Recommended values:
#   claude-sonnet-4-20250514  — balanced cost/quality, default
#   claude-opus-4-20250514    — higher quality for Keeper & Curator
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional — Ollama endpoint (only used when MODEL_PROVIDER=ollama)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.3:70b

# ── Institutional Turso (authoritative institutional record) ──────
# The terminal READS authoritative institutional state from the same
# Turso database the public site (website/) and system scripts use.
# These values match the ones in website/.env — same database.
# The terminal never writes to this database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Terminal Turso (operator state) ──────────────────────────────
# The terminal's own Turso database for operator state: the terminal
# event stream, Keeper chat sessions, outreach contacts, approvals,
# hardware snapshots, agent activity. Separate from the institutional
# database so operator notes and institutional law never mix.
#
# Create with: `turso db create mna-terminal --group default`
# Initialize with: `npm run migrate`
TERMINAL_TURSO_DATABASE_URL=
TERMINAL_TURSO_AUTH_TOKEN=

# ── Deployment ───────────────────────────────────────────────────
# NODE_ENV is set automatically by `next dev` / `next start`.
