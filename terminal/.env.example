# ─────────────────────────────────────────────────────────────────
# MNA Steward Terminal — environment configuration
#
# Copy to terminal/.env and fill in values. terminal/.env is gitignored.
# ─────────────────────────────────────────────────────────────────

# ── Auth ─────────────────────────────────────────────────────────
# The steward password hash is NOT stored here — bcrypt hashes contain
# $ signs which dotenv-expand interprets as variable references and
# silently corrupts. Instead, it lives in data/steward.hash, created by:
#   npm run hash-password
# The file is mode 0600 (read/write for owner only) and gitignored.

# HMAC secret for signing session cookies. Generate with:
#   openssl rand -hex 32
STEWARD_SESSION_SECRET=

# ── Model provider ───────────────────────────────────────────────
# "anthropic" (default, Claude API) or "ollama" (local, Mac Studio only)
MODEL_PROVIDER=anthropic

# Required if MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-sonnet-4-20250514.
# Recommended values:
#   claude-sonnet-4-20250514  — balanced cost/quality, default
#   claude-opus-4-20250514    — higher quality for Keeper & Curator
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional — Ollama endpoint (only used when MODEL_PROVIDER=ollama)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.3:70b

# ── Turso (institutional record) ─────────────────────────────────
# The terminal reads authoritative institutional state from the same
# Turso database the rest of MNA uses. These values match the ones
# in website/.env — see that file for the live credentials.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Deployment ───────────────────────────────────────────────────
# NODE_ENV is set automatically by `next dev` / `next start`.
